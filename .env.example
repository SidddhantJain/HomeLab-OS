# HomeLab OS Environment Configuration Example
# Copy this file to .env before starting the services

# System
PROJECT_NAME="HomeLab OS"
VERSION="v1.0"
ENV="development"
LOG_LEVEL="INFO"

# Database Configuration
POSTGRES_USER=homelab
POSTGRES_PASSWORD=homelab_secret_pass
POSTGRES_DB=homelab_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://homelab:homelab_secret_pass@postgres:5432/homelab_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & JWT Authentication
SECRET_KEY=homelab_super_secret_jwt_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
