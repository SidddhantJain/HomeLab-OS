<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.homelab.os.companion">

    <!-- Permissions for Hardware, Biometrics, Push Alerts, Media Sync, & WebRTC -->
    <uses-permission android.permission.INTERNET />
    <uses-permission android.permission.ACCESS_NETWORK_STATE />
    <uses-permission android.permission.USE_BIOMETRIC />
    <uses-permission android.permission.POST_NOTIFICATIONS />
    <uses-permission android.permission.READ_MEDIA_IMAGES />
    <uses-permission android.permission.READ_MEDIA_VIDEO />
    <uses-permission android.permission.FOREGROUND_SERVICE />
    <uses-permission android.permission.CAMERA />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="HomeLab OS Mobile Companion"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeLabCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="HomeLab OS Companion"
            android:theme="@style/Theme.HomeLabCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background FCM Push Notification Service -->
        <service
            android:name=".service.HomeLabMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
